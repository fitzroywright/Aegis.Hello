{
  "CommonSecrets": {
    "Mode": "Production",
    "ProviderOrder": [
      "PrimarySecrets"
    ],
    "Providers": {
      "PrimarySecrets": {
        "Type": "OpenBao",
        "Settings": {
          "Enabled": true,
          "Address": "https://openbao.ffpja.org",
          "MountPath": "secret",
          "BasePath": "aegis/hello",
          "RequireHttps": true,
          "SecretIdEnvironmentVariable": "AEGIS_HELLO_OPENBAO_SECRET_ID"
        }
      }
    }
  },
  "Aegis": {
    "PublicUrl": "https://hello.ffpja.org/",
    "Diagnostics": {
      "RequestCredentialSecretName": "diagnostic-level/request-credential"
    }
  },
  "Hello": {
    "RequiredMessage": "Hello from Kratos",
    "OptionalLabel": "Kratos reference registration app"
  }
}
